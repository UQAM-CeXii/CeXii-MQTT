{
  "name": "CeXii MQTT",
  "version": "0.1.0",
  "description": "Envoyer et recevoir des messages MQTT (broker EMQX en WebSocket) depuis un ESP32 ou un ESP32 PoE, avec topics guidés, messages système automatiques (error / infos), WiFi ou Ethernet.",
  "keywords": "cexii, mqtt, esp32, poe, ethernet, wifi, websocket, emqx",
  "frameworks": "arduino",
  "platforms": "espressif32",
  "dependencies": [
    {
      "name": "ArduinoJson",
      "owner": "bblanchon",
      "version": "^7.0.0"
    }
  ],
  "examples": [
    {
      "name": "01 Envoyer des nombres",
      "base": "examples/01_Envoyer_nombres",
      "files": [
        "platformio.ini",
        "01_Envoyer_nombres.ino"
      ]
    },
    {
      "name": "02 Envoyer un capteur",
      "base": "examples/02_Envoyer_capteur",
      "files": [
        "platformio.ini",
        "02_Envoyer_capteur.ino"
      ]
    },
    {
      "name": "03 Envoyer du texte",
      "base": "examples/03_Envoyer_texte",
      "files": [
        "platformio.ini",
        "03_Envoyer_texte.ino"
      ]
    },
    {
      "name": "04 Envoyer une table",
      "base": "examples/04_Envoyer_table",
      "files": [
        "platformio.ini",
        "04_Envoyer_table.ino"
      ]
    },
    {
      "name": "05 Recevoir des nombres",
