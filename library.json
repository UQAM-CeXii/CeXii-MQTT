{
  "name": "Saillance",
  "version": "0.1.0",
  "description": "Envoyer et recevoir des messages MQTT (broker EMQX en WebSocket) depuis un ESP32 ou un ESP32 PoE, avec topics guidés, messages système automatiques (error / infos), WiFi ou Ethernet.",
  "keywords": "mqtt, esp32, poe, ethernet, wifi, websocket, emqx, saillance",
  "frameworks": "arduino",
  "platforms": "espressif32",
  "dependencies": [
    {
      "name": "ArduinoJson",
      "owner": "bblanchon",
      "version": "^7.0.0"
    }
  ],
  "build": {
    "flags": ["-std=gnu++17"]
  },
  "examples": [
    {
      "name": "01 Envoyer des valeurs (WiFi)",
      "base": "examples/01_envoi_wifi",
      "files": ["platformio.ini", "src/main.cpp"]
    },
    {
      "name": "02 Ethernet PoE + bouton",
      "base": "examples/02_ethernet_bouton",
      "files": ["platformio.ini", "src/main.cpp"]
    },
    {
      "name": "03 Recevoir des valeurs",
      "base": "examples/03_reception",
      "files": ["platformio.ini", "src/main.cpp"]
    },
    {
      "name": "04 Envoyer du texte",
      "base": "examples/04_texte",
      "files": ["platformio.ini", "src/main.cpp"]
    }
  ]
}
